generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  role             String          @default("member") // "user" | "member" | "admin" | "supervisor"
  username         String?         @unique
  techStack        Json            @default("{}")    // Environnement technique personnel
  toolbox          Json            @default("{}")    // v4.0 : boîte à outils { categoryId: { selected, status, addedAt } }
  createdAt        DateTime        @default(now())
  projects           Project[]
  invitations        Invitation[]
  agents             Agent[]
  projectMemberships ProjectMember[]
  createdMilestones  Milestone[] @relation("MilestoneCreator")
  createdTodos       TodoItem[]  @relation("TodoCreator")
}

model Agent {
  id            String         @id @default(uuid())
  name          String
  role          String
  systemPrompt  String
  emoji         String         @default("🤖")
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])
  projectAgents ProjectAgent[]
}

model Invitation {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String?  // Si présent : auto-adhésion au projet après inscription
  project   Project? @relation(fields: [projectId], references: [id])
}

model Project {
  id            String          @id @default(uuid())
  name          String
  description   String?
  status        String          @default("active") // "active" ou "archived"
  brief             String?   // Brief structuré : objectif, contexte, notes — ajouté migration 20260603000012
  devDirectory      String?   // Répertoire de développement local — ajouté migration 20260613000003
  context           String?   // Mémoire cumulée des sessions précédentes
  techStack         Json?     // Surcharge de la stack technique de l'utilisateur
  hasTechnicalStack Boolean   @default(false) // v4.0 : projet implique du développement technique
  expertiseLevel    Int       @default(3) // v5.0 : 1 (découverte) à 5 (expert) — défaut des réunions du projet
  humorLevel        Int       @default(2) // v5.0 : 1 (sobre) à 5 (réunion de potes) — défaut des réunions du projet
  createdAt         DateTime  @default(now())
  updatedAt     DateTime        @updatedAt
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  sessions      Session[]
  members       ProjectMember[]
  invitations   Invitation[]
  projectAgents ProjectAgent[]
  milestones    Milestone[]
  todos         TodoItem[]
}

model ProjectAgent {
  id           String  @id @default(dbgenerated("gen_random_uuid()::text"))
  projectId    String
  agentId      String
  enabled      Boolean @default(true)
  displayOrder Int     @default(0)
  source       String  @default("manual") // "manual" | "suggestion"
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent        Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([projectId, agentId])
}

model Milestone {
  id           String     @id @default(dbgenerated("gen_random_uuid()::text"))
  projectId    String
  title        String
  description  String?
  dueDate      DateTime?
  status              String     @default("pending") // "pending" | "in_progress" | "done" | "blocked"
  type                String     @default("meeting") // valeurs réelles : "meeting" | "synthesis" | "stack_check" | "claude_code" | "technical" | "memory" | "timeline_steps" | "milestone" — à consolider en phase 3 (decision | claude_code | stack)
  checklistData       Json?      // { items: [{ id, label, category, checked, notes }] }
  createdFromSessionId String?
  displayOrder        Int        @default(0)
  createdAt    DateTime   @default(now())
  createdBy    String?
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator      User?      @relation("MilestoneCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  todos              TodoItem[]
  sessions           Session[]  @relation("SessionMilestone")
  createdFromSession Session?   @relation("MilestoneSource", fields: [createdFromSessionId], references: [id], onDelete: SetNull)
}

model TodoItem {
  id           String     @id @default(dbgenerated("gen_random_uuid()::text"))
  projectId    String
  milestoneId  String?
  title        String
  description  String?
  status       String     @default("todo")    // "todo" | "in_progress" | "done" | "cancelled"
  priority     String     @default("medium")  // "low" | "medium" | "high"
  dueDate      DateTime?
  displayOrder Int        @default(0)
  source       String     @default("manual")  // "manual" | "agent" | "session"
  sessionId    String?
  createdAt    DateTime   @default(now())
  createdBy    String?
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  session      Session?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  creator      User?      @relation("TodoCreator", fields: [createdBy], references: [id], onDelete: SetNull)
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("collaborator") // "collaborator" ou "viewer"
  invitedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Session {
  id              String    @id @default(uuid())
  task            String
  agents          Json
  exchanges       Json
  summary         String?
  status          String    @default("complete") // "open" | "accepted" | "abandoned" (CHECK contraint ajoutée en v3 — le défaut "complete" ci-dessus est un résidu v1, jamais utilisé : tous les chemins de création renseignent status explicitement)
  mode            String    @default("realtime") // "meeting" uniquement depuis v5.0 (toute création passe par crud.js avec mode explicite) — le défaut "realtime" ci-dessus est un résidu v1/legacy, jamais utilisé en pratique ; "realtime"/"conversation" (legacy) ont été migrés vers "meeting" en phase 1
  hasCode         Boolean   @default(false)
  codeStatus      String?   // null | "implemented" | "not_generated"
  model           String    @default("claude-sonnet-4-6")
  fullContext     Boolean   @default(false)
  suggestedTools  Json?     // { suggestedTools: string[], missingTools: string[] }
  planSuggestions Json?     // { milestones: [...], standalone_todos: [...] }
  timeline        Json      @default("[]") // [ { id, type, label, status, timestamp, meta } ]
  intention       Json?     @default("[]") // livrable attendu, un seul élément en pratique : "summary" | "claude_code" (seuls choix proposés à la création depuis StartMeeting.jsx) — "synthesis" | "memory" | "timeline_steps" | "meeting" | "technical" sont des valeurs legacy encore gérées en lecture (chat.js, generate-deliverable) mais plus jamais créées
  messages        Json?     @default("[]") // v3.0 : fil de conversation [{ id, role, agentName, content, timestamp, type, pinned }]
  activeAgents           Json?     @default("[]") // v3.0 : agents actifs [{ id, name, role, systemPrompt, emoji, joinedAt }]
  pendingStepSuggestions  Json?     @default("[]")                                      // v3.6 : étapes suggérées hors-contexte [{ title, type, agentName, timestamp }]
  tokensUsed              Json?     @default("{\"input\":0,\"output\":0,\"total\":0}")  // v3.6 : tokens Anthropic cumulés { input, output, total }
  pendingToolSuggestions  Json?     @default("[]")    // v4.0 : outils détectés via [NEED_TOOL:...] [{ name, reason, required, agentName, timestamp }]
  webSearchEnabled        Boolean   @default(false)   // v4.0 (Év.6) : activer la recherche web pour cette réunion
  expertiseLevel          Int?      // v5.0 : 1 à 5, null = hérite de Project.expertiseLevel
  humorLevel              Int?      // v5.0 : 1 à 5, null = hérite de Project.humorLevel
  milestoneId     String?
  todos           TodoItem[]
  createdAt       DateTime  @default(now())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  parentSessionId String?
  parentSession   Session?  @relation("SessionContinuation", fields: [parentSessionId], references: [id])
  continuations   Session[] @relation("SessionContinuation")
  milestone         Milestone? @relation("SessionMilestone", fields: [milestoneId], references: [id], onDelete: SetNull)
  sourcedMilestones Milestone[] @relation("MilestoneSource")
}
