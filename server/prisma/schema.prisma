generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  role             String          @default("member") // "user" | "member" | "admin" | "supervisor"
  username         String?         @unique
  techStack        Json            @default("{}")    // DEPRECATED v5.0 — migré vers tools (phase 4), conservé en lecture seule
  toolbox          Json            @default("{}")    // DEPRECATED v5.0 — migré vers tools (phase 4), conservé en lecture seule
  tools            Json?           // v5.0 phase 4 : « Mes outils » [{ id, catalogId, name, category, cost, status: using|account|to_try, note }] — NULL = pas encore migré (cf. toolsStore.js)
  tutorialSeenAt   DateTime?       // v5.1 : guide de prise en main vu (NULL = à afficher à la connexion)
  reminderDay         Int       @default(1) // v5.1 : jour des rappels hebdomadaires, 1 = lundi … 7 = dimanche
  remindersLastSentAt DateTime? // v5.1 : dernier rappel envoyé (un par semaine)
  tourProgress     Json            @default("{}") // v5.1 : chapitres de la visite guidée terminés { chapitre: date ISO }
  githubInstallationId String?   // v5.1 : installation de l'application GitHub BlabIA (services/github.js)
  githubLogin          String?   // v5.1 : compte GitHub connecté
  createdAt        DateTime        @default(now())
  projects           Project[]
  invitations        Invitation[]
  agents             Agent[]
  projectMemberships ProjectMember[]
  createdMilestones  Milestone[] @relation("MilestoneCreator")
  createdTodos       TodoItem[]  @relation("TodoCreator")
  usageLogs          UsageLog[]
  documents          ProjectDocument[]
  approvedMissions   AgentMission[]
  devTasks           DevTask[]
}

model Agent {
  id            String         @id @default(uuid())
  name          String
  role          String
  systemPrompt  String
  emoji         String         @default("🤖")
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])
  projectAgents ProjectAgent[]
}

model Invitation {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String?  // Si présent : auto-adhésion au projet après inscription
  project   Project? @relation(fields: [projectId], references: [id])
}

model Project {
  id            String          @id @default(uuid())
  name          String
  description   String?
  status        String          @default("active") // "active" ou "archived"
  brief             String?   // Brief structuré : objectif, contexte, notes — ajouté migration 20260603000012
  devDirectory      String?   // Répertoire de développement local — ajouté migration 20260613000003
  context           String?   // Mémoire cumulée des sessions précédentes
  techStack         Json?     // DEPRECATED v5.0 — migré vers tools (phase 4), conservé en lecture seule
  hasTechnicalStack Boolean   @default(false) // DEPRECATED v5.0 — remplacé par tools (phase 4) ; seulement lu par la migration
  tools             Json?     // v5.0 phase 4 : outils du projet [{ id, catalogId, name, category, origin: mine|complementary, status: suggested|validated|refused, need, why, cost, priceSource, sessionId, warning }] — NULL = pas encore migré
  toolNeeds         Json?     // v5.0 phase 4 : besoins en outils analysés par BlabIA [{ category, need, fit: ok|unsuited|none, warning, examples }] — NULL = jamais analysé
  toolsGuide        String?   // v5.1 : guide de mise en place des outils (Markdown, services/tools/setupGuide.js), régénéré à la demande
  toolsGuideAt      DateTime?
  toolsGuideChat    Json      @default("[]") // v5.1 : discussion sous le guide [{ role, content, at }] (questions, erreurs collées)
  expertiseLevel    Int       @default(3) // v5.0 : 1 (découverte) à 5 (expert) — défaut des réunions du projet
  humorLevel        Int       @default(2) // v5.0 : 1 (sobre) à 5 (réunion de potes) — défaut des réunions du projet
  questionMode      String    @default("balanced") // v5.0 : "delegate" (4 questions) | "balanced" (8) | "control" (15) — défaut des réunions du projet
  missionsMonthlyBudgetUSD Float @default(5) // v5.1 : budget mensuel des missions des agents (services/missions.js)
  remindersEnabled  Boolean   @default(false) // v5.1 : rappels hebdomadaires par e-mail des actions (services/reminders.js)
  challengerEnabled Boolean   @default(true) // v5.1 : contradicteur (avocat du diable sélectif, services/challenger.js), activé par défaut
  githubRepo        String?   // v5.1 : dépôt GitHub du projet « propriétaire/nom » (développements, services/devTasks.js)
  siteUrl           String?   // v5.1 : adresse publique du site (renseignée : Railway ne la transmet pas à GitHub)
  isDemo            Boolean   @default(false) // v5.1 : projet exemple de la visite guidée (services/demoProject.js), sans appel à l'IA, supprimé en fin de visite
  createdAt         DateTime  @default(now())
  updatedAt     DateTime        @updatedAt
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  sessions      Session[]
  members       ProjectMember[]
  invitations   Invitation[]
  projectAgents ProjectAgent[]
  milestones    Milestone[]
  todos         TodoItem[]
  decisions     Decision[]
  usageLogs     UsageLog[]
  documents     ProjectDocument[]
  missions      AgentMission[]
  devTasks      DevTask[]
}

model ProjectAgent {
  id           String  @id @default(dbgenerated("gen_random_uuid()::text"))
  projectId    String
  agentId      String
  enabled      Boolean @default(true)
  displayOrder Int     @default(0)
  source       String  @default("manual") // "manual" | "suggestion"
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent        Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([projectId, agentId])
}

model Milestone {
  id           String     @id @default(dbgenerated("gen_random_uuid()::text"))
  projectId    String
  title        String
  description  String?
  dueDate      DateTime?
  status              String     @default("pending") // "pending" | "in_progress" | "done" | "blocked"
  type                String     @default("decision") // v5.0 phase 3 : "decision" | "claude_code" | "stack" — anciennes valeurs ("meeting" | "synthesis" | "stack_check" | "technical" | "memory" | "timeline_steps" | "milestone") migrées en phase 3 (stack_check -> stack, tout le reste -> decision)
  checklistData       Json?      // DEPRECATED v5.0 — checklist stack_check, remplacée par les réunions de type stack (phase 4)
  createdFromSessionId String?
  displayOrder        Int        @default(0)
  createdAt    DateTime   @default(now())
  createdBy    String?
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator      User?      @relation("MilestoneCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  todos              TodoItem[]
  sessions           Session[]  @relation("SessionMilestone")
  createdFromSession Session?   @relation("MilestoneSource", fields: [createdFromSessionId], references: [id], onDelete: SetNull)
}

model TodoItem {
  id           String     @id @default(dbgenerated("gen_random_uuid()::text"))
  projectId    String
  milestoneId  String?
  title        String
  description  String?
  status       String     @default("todo")    // "todo" | "in_progress" | "done" | "cancelled"
  priority     String     @default("medium")  // "low" | "medium" | "high"
  dueDate      DateTime?
  displayOrder Int        @default(0)
  source       String     @default("manual")  // "manual" | "agent" | "session"
  sessionId    String?
  createdAt    DateTime   @default(now())
  createdBy    String?
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  session      Session?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  creator      User?      @relation("TodoCreator", fields: [createdBy], references: [id], onDelete: SetNull)
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("collaborator") // "collaborator" ou "viewer"
  invitedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Session {
  id              String    @id @default(uuid())
  task            String
  agents          Json      @default("[]") // DEPRECATED v5.1 — plus écrit ni lu (remplacé par activeAgents) ; suppression à décider
  exchanges       Json      @default("[]") // DEPRECATED v5.1 — plus écrit ni lu (remplacé par messages) ; suppression à décider
  summary         String?   // compte-rendu de la réunion (toujours produit à la clôture)
  deliverable     String?   // v5.0 phase 3 : livrable typé (prompt Claude Code, relevé de décisions texte, proposition d'outils) — distinct du compte-rendu depuis la phase 3 ; avant, le prompt claude_code était stocké dans summary
  status          String    @default("complete") // "open" | "accepted" | "abandoned" (CHECK contraint ajoutée en v3 — le défaut "complete" ci-dessus est un résidu v1, jamais utilisé : tous les chemins de création renseignent status explicitement)
  mode            String    @default("realtime") // "meeting" uniquement depuis v5.0 (toute création passe par crud.js avec mode explicite) — le défaut "realtime" ci-dessus est un résidu v1/legacy, jamais utilisé en pratique ; "realtime"/"conversation" (legacy) ont été migrés vers "meeting" en phase 1
  hasCode         Boolean   @default(false)
  codeStatus      String?   // null | "implemented" | "not_generated"
  model           String    @default("claude-sonnet-4-6")
  fullContext     Boolean   @default(false)
  suggestedTools  Json?     // DEPRECATED v5.0 — remplacé par pendingToolSuggestions (phase 4)
  planSuggestions Json?     // { milestones: [...], standalone_todos: [...] }
  timeline        Json      @default("[]") // [ { id, type, label, status, timestamp, meta } ]
  intention       Json?     @default("[]") // v5.0 phase 3 : livrable attendu, un seul élément : "decision" | "claude_code" | "stack" (seuls choix proposés à la création depuis StartMeeting.jsx) — anciennes valeurs ("summary" | "synthesis" | "memory" | "timeline_steps" | "meeting" | "technical") migrées vers "decision" (claude_code conservé)
  messages        Json?     @default("[]") // v3.0 : fil de conversation [{ id, role, agentName, content, timestamp, type, pinned }]
  activeAgents           Json?     @default("[]") // v3.0 : agents actifs [{ id, name, role, systemPrompt, emoji, joinedAt }]
  pendingStepSuggestions  Json?     @default("[]")                                      // DEPRECATED v5.0 — remplacé par pendingMeetingSuggestions (phase 3.4), conservé en lecture seule pour les anciennes réunions non closes
  pendingMeetingSuggestions Json?   @default("[]")                                      // v5.0 phase 3.4 : [{ id, title, objective, type, reason, after, status: pending|kept|discarded, agentName, timestamp, editedTitle?, editedType? }]
  tokensUsed              Json?     @default("{\"input\":0,\"output\":0,\"total\":0}")  // v3.6 : tokens Anthropic cumulés { input, output, total }
  pendingToolSuggestions  Json?     @default("[]")    // v5.0 phase 4 : outils signalés via [NEED_TOOL:...] [{ id, name, category, need, why, cost, priceSource, agentName, timestamp }] — validés un par un à la clôture (anciennes entrées v4 { id, label, category, required, reason } lues par la migration)
  webSearchEnabled        Boolean   @default(false)   // v4.0 (Év.6) : activer la recherche web pour cette réunion
  expertiseLevel          Int?      // v5.0 : 1 à 5, null = hérite de Project.expertiseLevel
  humorLevel              Int?      // v5.0 : 1 à 5, null = hérite de Project.humorLevel
  questionMode            String?   // v5.0 : "delegate" | "balanced" | "control" (budget de questions 4 / 8 / 15), null = hérite de Project.questionMode
  challengerEnabled       Boolean?  // v5.1 : contradicteur — false = désactivé pour cette réunion, null = hérite de Project.challengerEnabled
  codeContext     String?   // v5.1 : réunion Claude Code — code du dépôt vu par les agents (services/codeContext.js), calculé au 1er tour
  requiredTools   Json?     // v5.1 : réunion Claude Code — types d'outils utilisés par le développement (services/devTools.js), null = pas encore repéré
  milestoneId     String?
  todos           TodoItem[]
  createdAt       DateTime  @default(now())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  parentSessionId String?
  parentSession   Session?  @relation("SessionContinuation", fields: [parentSessionId], references: [id])
  continuations   Session[] @relation("SessionContinuation")
  milestone         Milestone? @relation("SessionMilestone", fields: [milestoneId], references: [id], onDelete: SetNull)
  sourcedMilestones Milestone[] @relation("MilestoneSource")
  decisions         Decision[]
  usageLogs         UsageLog[]
  missions          AgentMission[]
  devTasks          DevTask[]
}

// v5.0 : registre des décisions du projet — alimenté à la clôture des réunions
// (après validation de l'humain), transmis aux agents pour ne pas reposer ce qui est tranché.
model Decision {
  id              String   @id @default(dbgenerated("gen_random_uuid()::text"))
  projectId       String
  sessionId       String?
  statement       String   // la décision, en une phrase
  rationale       String?  // pourquoi
  rejectedOptions Json     @default("[]") // options écartées (string[])
  origin          String   @default("human")  // "human" (arbitrage explicite) | "agents" (hypothèse non contredite)
  status          String   @default("active") // "active" | "reopened" (remise en question) | "superseded"
  reopenNote      String?  // raison de la remise en question
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session         Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

// v5.1 : coût réel de l'IA — une ligne par appel Anthropic (services/usage.js)
model UsageLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()::text"))
  userId           String?
  projectId        String?
  sessionId        String?
  kind             String   @default("other") // origine : chat, generate-deliverable, quick-command, …
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheWriteTokens Int      @default(0)
  cacheReadTokens  Int      @default(0)
  webSearches      Int      @default(0)
  costUSD          Float    @default(0) // calculé au tarif du modèle (services/pricing.js)
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project          Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session          Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([createdAt])
}

// v5.1 : documents de référence du projet (services/documents.js) — texte extrait au dépôt,
// lu par les agents à chaque réunion si enabled (bloc commun du prompt, mis en cache)
model ProjectDocument {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  projectId String
  name      String
  mimeType  String?
  sizeBytes Int      @default(0)
  charCount Int      @default(0)
  content   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator   User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  missions  AgentMission[]

  @@index([projectId])
}

// v5.1 : missions des agents (services/missions.js, services/missionRunner.js) — proposées
// en réunion par un agent, validées par l'humain, menées en arrière-plan par un sous-agent
// avec un plafond de coût ; le rapport rejoint les documents du projet.
model AgentMission {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  projectId   String
  sessionId   String?
  agentName   String
  kind        String    @default("research") // research | analysis | writing
  title       String
  objective   String
  deliverable String?
  status      String    @default("proposed") // proposed | queued | running | done | failed | rejected | cancelled
  budgetUSD   Float     @default(0.5)
  costUSD     Float     @default(0)
  attempts    Int       @default(0)
  report      String?
  sources     Json      @default("[]")
  error       String?
  documentId  String?
  approvedBy  String?
  createdAt   DateTime  @default(now())
  approvedAt  DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session     Session?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  document    ProjectDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  approver    User?            @relation(fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
}

// v5.1 : développements lancés depuis BlabIA (services/devTasks.js) — Claude Code dans
// GitHub Actions sur le dépôt du projet : demande (issue) → pull request → mise en ligne
// (sauvegarde de la base puis fusion, workflow blabia-deploy.yml).
model DevTask {
  id                String    @id @default(dbgenerated("gen_random_uuid()::text"))
  projectId         String
  sessionId         String?
  createdBy         String?
  repo              String
  title             String
  prompt            String
  status            String    @default("running") // running | ready | failed | deploying | deployed | deploy_failed | abandoned
  issueNumber       Int?
  issueUrl          String?
  prNumber          Int?
  prUrl             String?
  summary           String?
  files             Json      @default("[]") // [{ filename, additions, deletions }]
  touchesDatabase   Boolean   @default(false)
  runUrl            String?
  previewUrl        String?   // v5.1 : aperçu de la pull request publié par l'hébergeur (déploiement GitHub)
  siteUrl           String?   // v5.1 : adresse du site publié après fusion
  mergeSha          String?   // v5.1 : commit de fusion, pour retrouver sa publication
  publishState      String?   // v5.1 : pending | live | failed | no_host | unknown (services/devTasks.js)
  error             String?
  createdAt         DateTime  @default(now())
  readyAt           DateTime?
  deployRequestedAt DateTime?
  finishedAt        DateTime?
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session           Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  creator           User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId])
}
