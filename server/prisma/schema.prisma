generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  role             String          @default("guest") // "admin", "guest" ou "collaborator"
  techStack        Json            @default("{}")    // Environnement technique personnel
  createdAt        DateTime        @default(now())
  projects         Project[]
  invitations      Invitation[]
  agents           Agent[]
  projectMemberships ProjectMember[]
}

model Agent {
  id           String   @id @default(uuid())
  name         String
  role         String
  systemPrompt String
  emoji        String   @default("🤖")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
}

model Invitation {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String?  // Si présent : auto-adhésion au projet après inscription
  project   Project? @relation(fields: [projectId], references: [id])
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  status      String          @default("active") // "active" ou "archived"
  context     String?         // Mémoire cumulée des sessions précédentes
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  sessions    Session[]
  members     ProjectMember[]
  invitations Invitation[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("collaborator") // "collaborator" ou "viewer"
  invitedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Session {
  id              String    @id @default(uuid())
  task            String
  agents          Json
  exchanges       Json
  summary         String?
  status          String    @default("complete") // "complete" ou "interrupted"
  mode            String    @default("realtime") // "realtime" ou "summary"
  createdAt       DateTime  @default(now())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  parentSessionId String?
  parentSession   Session?  @relation("SessionContinuation", fields: [parentSessionId], references: [id])
  continuations   Session[] @relation("SessionContinuation")
}
