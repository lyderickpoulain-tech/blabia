DATABASE_URL=postgresql://username:password@localhost:5432/blabIa
JWT_SECRET=une_cle_secrete_longue_et_aleatoire_ici
ANTHROPIC_API_KEY=sk-ant-api03-...
PORT=3001
FRONTEND_URL=http://localhost:5173

# E-mails via Resend (optionnel — si absent, les liens s'affichent dans la console)
RESEND_API_KEY=
# Rappels : secret de la route appelée par une tâche planifiée (optionnel) ; REMINDERS_DISABLED=1 coupe les rappels
CRON_SECRET=
REMINDERS_DISABLED=

# Ancien envoi par SMTP (non utilisé par le code actuel)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=BlabIA <no-reply@example.com>

# Développements depuis BlabIA (optionnel — application GitHub BlabIA ; sans elles, la fonctionnalité est masquée)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Clé privée PEM de l'application (retours à la ligne écrits 
 si besoin)
GITHUB_APP_PRIVATE_KEY=

# Mise en ligne automatique chez Railway (optionnel — connecteur services/railway.js ; sans elles, la carte l'indique)
# Railway › paramètres de l'espace de travail › Developer › New OAuth App ; adresse de retour : <BlabIA>/api/railway/callback
RAILWAY_OAUTH_CLIENT_ID=
RAILWAY_OAUTH_CLIENT_SECRET=
# Facultatif : base de l'adresse de retour si elle diffère de l'adresse du serveur (ex. https://blabia-production.up.railway.app)
RAILWAY_OAUTH_REDIRECT_BASE=
