# ── Base de données (Railway PostgreSQL plugin le fournit automatiquement) ────
DATABASE_URL=postgresql://username:password@host:5432/railway

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=une_cle_secrete_tres_longue_et_aleatoire_au_moins_64_chars

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── URL de l'application (Railway la fournit dans les variables auto) ──────────
# Format : https://votre-app.up.railway.app
FRONTEND_URL=https://votre-app.up.railway.app

# ── E-mails via Resend (optionnel — si absent, les liens s'affichent en console) ──
RESEND_API_KEY=
# Rappels : secret de la route appelée par une tâche planifiée (optionnel)
CRON_SECRET=

# ── Développements depuis BlabIA (optionnel — application GitHub BlabIA ; sans elles, fonctionnalité masquée) ──
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# ── Ancien envoi par SMTP (non utilisé par le code actuel) ─────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_user_smtp
SMTP_PASS=votre_mot_de_passe_smtp
SMTP_FROM=BlabIA <no-reply@votre-domaine.fr>
